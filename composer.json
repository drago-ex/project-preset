{
	"name": "drago-ex/project-preset",
	"description": "Overlay preset that turns an installed Drago Project into a backend-ready stack.",
	"type": "drago-tools-resource",
	"license": "MIT",
	"require": {
		"php": ">=8.3 <9",
		"drago-ex/translator": "^4.0",
		"drago-ex/project-docker": "^1.0",
		"drago-ex/project-docker-db": "^1.0",
		"drago-ex/project-front": "^1.0",
		"drago-ex/project-backend": "^1.0",
		"drago-ex/project-backend-ui": "^1.0",
		"drago-ex/permission": "^1.0",
		"drago-ex/datagrid": "^1.0",
		"drago-ex/project-permission": "^1.0",
		"drago-ex/project-settings": "^1.0",
		"drago-ex/project-blog": "^1.0",
		"drago-ex/project-static-page": "^1.0"
	},
	"require-dev": {
		"phpstan/phpstan-nette": "^2.0"
	},
	"extra": {
		"drago-tools": {
			"install": {
				"replace-once": true,
				"replace-priority": 300,
				"replace": {
					"resources/app": "app",
					"resources/assets": "assets",
					"resources/package.json": "package.json"
				}
			}
		},
		"drago-translator": {
			"translation": "app/Presentation/Front/Translate"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse"
	}
}
