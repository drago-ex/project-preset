{
	"name": "drago-ex/project-preset",
	"description": "Overlay preset that turns an installed Drago Project into a backend-ready stack.",
	"type": "drago-tools-resource",
	"license": "MIT",
	"require": {
		"php": ">=8.3 <9",
		"drago-ex/project-docker": "^1.0",
		"drago-ex/project-docker-db": "^1.1",
		"drago-ex/project-front": "^3.0",
		"drago-ex/project-backend": "^1.0",
		"drago-ex/project-backend-ui": "^1.0",
		"drago-ex/project-front-ui": "^1.0",
		"drago-ex/project-settings": "^2.0",
		"drago-ex/project-blog": "^2.0",
		"drago-ex/project-static-page": "^2.0",
		"drago-ex/project-gallery": "^1.0",
		"drago-ex/project-permission": "^3.0"
	},
	"extra": {
		"drago-tools": {
			"install": {
				"replace-once": true,
				"replace-priority": 300,
				"replace": {
					"resources/assets": "assets"
				}
			}
		}
	}
}
