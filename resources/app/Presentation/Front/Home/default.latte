{templateType App\Presentation\Front\Home\HomeTemplate}
{import '../../Accessory/Widget/@brand.latte'}

{block content}
	<section class="front-hero text-center py-5 mb-5 rounded-4">
		<h1 class="display-5 fw-semibold mb-3">{include brand}</h1>
		<p class="lead text-body-secondary mb-4">{_'Welcome to our website.'}</p>
		<a n:href=":Front:Blog:" class="btn btn-primary btn-lg px-4">{_'Read the blog'}</a>
	</section>

	<section>
		<div class="d-flex align-items-baseline justify-content-between mb-3">
			<h2 class="h4 mb-0">{_'Latest articles'}</h2>
			<a n:if="$articles" n:href=":Front:Blog:" class="link-secondary small">{_'All articles'} &rarr;</a>
		</div>

		<div n:if="$articles" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
			<div n:foreach="$articles as $article" class="col">
				<article class="card h-100 border-0 shadow-sm front-card">
					<div class="card-body d-flex flex-column">
						<div n:if="$article->published_at" class="small text-body-secondary mb-2">
							{$article->published_at|date:'j. n. Y'}
						</div>
						<h3 class="h5 card-title">
							<a n:href=":Front:Blog:detail, slug: $article->slug" class="stretched-link text-decoration-none text-body-emphasis">
								{$article->title}
							</a>
						</h3>
						<p n:if="$article->perex" class="card-text text-body-secondary mb-0">{$article->perex|truncate:160}</p>
					</div>
				</article>
			</div>
		</div>

		<p n:if="!$articles" class="text-body-secondary">{_'No published articles yet.'}</p>
	</section>
{/block}
